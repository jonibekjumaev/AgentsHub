PORT_API=3000
PORT_BATCH=3008

MONGODB_DEV=mongodb+srv://<user>:<password>@<cluster-host>/agentsHub?retryWrites=true&w=majority
MONGODB_PROD=mongodb+srv://<user>:<password>@<cluster-host>/<prod-db-decided-at-deploy>?retryWrites=true&w=majority
SECRET_TOKEN=<random-secret-for-jwt>

# npm run create-admin (D-14) and npm run seed: the first admin, created only if ADMIN_NICK does not exist
ADMIN_NICK=<3-12 characters>
ADMIN_PASSWORD=<8+ characters>
ADMIN_PHONE=<E.164, e.g. +998901234567>

# npm run seed (dev only): the password of every seed_* member
SEED_PASSWORD=<8+ characters>

# D-51: behind a reverse proxy (nginx, a load balancer), the number of proxies in front of the API (usually 1) or
# their address, so the login throttle sees the real client address. Leave empty when clients connect directly.
TRUST_PROXY=

# D-52: semantic search. With a key, products and briefs get vectors (in the background and by the batch's reconcile
# job) and text searches go by meaning; without one, search stays by title. After setting it on a new cluster, run
# `npm run create-search-indexes` once. EMBEDDING_MODEL and VOYAGE_BASE_URL are optional (voyage-4-lite, the Voyage
# API; an Atlas model API key uses https://ai.mongodb.com/v1).
VOYAGE_API_KEY=
EMBEDDING_MODEL=
VOYAGE_BASE_URL=
