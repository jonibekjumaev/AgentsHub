PORT_API=3000
PORT_BATCH=3008

MONGODB_DEV=mongodb+srv://<user>:<password>@<cluster-host>/agentsHub?retryWrites=true&w=majority
MONGODB_PROD=mongodb+srv://<user>:<password>@<cluster-host>/<prod-db-decided-at-deploy>?retryWrites=true&w=majority
SECRET_TOKEN=<random-secret-for-jwt>

# npm run create-admin (D-14) and npm run seed: the first admin, created only if ADMIN_NICK does not exist
ADMIN_NICK=<3-12 characters>
ADMIN_PASSWORD=<8+ characters>
ADMIN_PHONE=<E.164, e.g. +998901234567>

# npm run seed (dev only): the password of every seed_* member
SEED_PASSWORD=<8+ characters>
